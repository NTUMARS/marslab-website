---
import { i18n } from "astro:config/client";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "$layouts/Base.astro";
import { people } from "$data/people";

export async function getStaticPaths() {
	return i18n!.locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}

const { locale = i18n!.defaultLocale } = Astro.params;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

// Anchor ids must match the People page exactly
const slugify = (name: string) => name.toLowerCase().replace(/[^a-z]/g, '');
const imageUrl = (person: any) => baseUrl + person.image.replace(/^\//, '');
const peopleWithImages = people.filter(person => person.image);

// PI = the sun at the centre; everyone else orbits on three rings, in roster order.
const pi = peopleWithImages[0];
const orbiters = peopleWithImages.slice(1);

// The dial is drawn on a 640×640 grid ("dial units"); CSS maps 1 unit to --u,
// so the whole instrument scales fluidly with its container.
const C = 320;           // centre
const SUN = 128;         // PI avatar diameter
const AV = 46;           // member avatar diameter
const RINGS = [
	{ r: 124, dur: 140, reverse: false },
	{ r: 195, dur: 190, reverse: true },
	{ r: 266, dur: 240, reverse: false },
];

// Seats per ring ∝ ring circumference (largest remainder), so every orbit keeps the
// same spacing as the roster grows; postdocs, listed first, fill the inner ring.
const totalR = RINGS.reduce((sum, ring) => sum + ring.r, 0);
const quota = RINGS.map(ring => orbiters.length * ring.r / totalR);
const seats = quota.map(q => Math.floor(q));
quota
	.map((q, i) => ({ frac: q - Math.floor(q), i }))
	.sort((a, b) => b.frac - a.frac)
	.slice(0, orbiters.length - seats.reduce((a, b) => a + b, 0))
	.forEach(({ i }) => seats[i]++);

let cursor = 0;
const orbits = RINGS.map((ring, ri) => {
	const members = orbiters.slice(cursor, cursor + seats[ri]);
	const first = cursor;
	cursor += members.length;
	const step = 360 / Math.max(members.length, 1);
	// stagger rings so no seats line up at rest
	const phase = step * ri / RINGS.length;
	return {
		...ring,
		// stroke length for the draw-in; dial-hand length from the avatar edge to the PI bezel
		len: Math.ceil(2 * Math.PI * ring.r) + 2,
		spoke: ring.r - AV * 0.5 - 88,
		members: members.map((person, mi) => ({
			person,
			id: slugify(person.name),
			index: first + mi,
			angle: +(phase + mi * step).toFixed(3),
		})),
	};
});

// Bezel around the PI: a tick every 5°, a longer one every 30°.
const ticks = Array.from({ length: 72 }, (_, i) => {
	const a = i * 5 * Math.PI / 180;
	const major = i % 6 === 0;
	const r0 = major ? 77 : 80, r1 = 84;
	const pt = (r: number) => [+(C + r * Math.sin(a)).toFixed(2), +(C - r * Math.cos(a)).toFixed(2)];
	const [x1, y1] = pt(r0), [x2, y2] = pt(r1);
	return { x1, y1, x2, y2, major };
});

---

<Base title="The MARS Lab" {locale}>
	<main class="constellation-page">
		<header class="cp-head">
			<p class="cp-kicker"><span>Constellation</span></p>
			<h1 class="cp-title">The MARS Lab</h1>
			<p class="cp-sub">
				<span class="cp-sub-hover">Hover a face to meet the team.</span>
				<span class="cp-sub-touch">Tap a face to meet the team.</span>
			</p>
		</header>

		<div class="constellation-wrap">
			<div class="constellation" role="group" aria-label={`MARS Lab members orbiting ${pi.name}`}>
				<span class="cs-plate" aria-hidden="true"></span>

				<svg class="cs-dial" viewBox="0 0 640 640" aria-hidden="true" focusable="false">
					<defs>
						<linearGradient id="cs-rim-grad" gradientUnits="userSpaceOnUse" x1="90" y1="30" x2="550" y2="610">
							<stop offset="0" class="cs-stop-hi" />
							<stop offset="0.5" class="cs-stop-mid" />
							<stop offset="1" class="cs-stop-lo" />
						</linearGradient>
					</defs>

					<!-- rim: a quiet double hairline -->
					<circle class="cs-rim cs-rim--outer" cx={C} cy={C} r="318" />
					<circle class="cs-rim cs-rim--inner" cx={C} cy={C} r="313.5" />

					{orbits.map((orbit, ri) => (
						<circle class={`cs-orbit cs-orbit-${ri}`} cx={C} cy={C} r={orbit.r} style={`--len:${orbit.len}; --ri:${ri}`} />
					))}

					<!-- PI bezel -->
					<circle class="cs-halo" cx={C} cy={C} r="72" />
					<g class="cs-ticks">
						{ticks.map((t) => (
							<line class:list={["cs-tick", { "cs-tick--major": t.major }]} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
						))}
					</g>
				</svg>

				<a href={getRelativeLocaleUrl(locale, `/people#${slugify(pi.name)}`)} class="sun" aria-label={`${pi.name}, ${pi.position}`} data-no-swup>
					<img src={imageUrl(pi)} alt={pi.name} width={SUN * 2} height={SUN * 2} loading="eager" decoding="async" />
					<span class="cs-label cs-label--sun" aria-hidden="true">
						<span class="cs-label-name">{pi.name}</span>
						<span class="cs-label-role">{pi.position}</span>
					</span>
				</a>

				{orbits.map((orbit, ri) => (
					<div class:list={["orbit", `orbit-${ri}`, { "orbit--rev": orbit.reverse }]} style={`--dur:${orbit.dur}s`}>
						{orbit.members.map((m) => (
							<a
								class="planet"
								href={getRelativeLocaleUrl(locale, `/people#${m.id}`)}
								aria-label={`${m.person.name}, ${m.person.position}`}
								data-no-swup
								style={`--angle:${m.angle}deg; --r:${orbit.r}; --spoke:${orbit.spoke}; --i:${m.index}`}
							>
								<span class="planet-spin">
									<img src={imageUrl(m.person)} alt={m.person.name} width={AV * 2} height={AV * 2} loading="eager" decoding="async" fetchpriority="low" />
									<span class="cs-label" aria-hidden="true">
										<span class="cs-label-name">{m.person.name}</span>
										<span class="cs-label-role">{m.person.position}</span>
									</span>
								</span>
							</a>
						))}
					</div>
				))}
			</div>
		</div>
	</main>
</Base>

<style>
	/* ===================== PAGE ===================== */
	.constellation-page {
		/* instrument palette — pale champagne on porcelain */
		--cs-gold: #B9975E;
		--cs-ink: #9A7B4A;
		--cs-line: rgba(185, 151, 94, 0.2);
		--cs-line-hot: rgba(185, 151, 94, 0.7);
		--cs-hair: rgba(185, 151, 94, 0.34);
		--cs-shade: 112, 96, 70;
		--cs-plate-hi: #FFFFFF;
		--cs-plate-lo: #FBF9F4;
		--cs-glow: rgba(185, 151, 94, 0.055);
		--cs-glint: rgba(255, 255, 255, 0.9);

		display: flex; flex-direction: column; align-items: center;
		gap: 1.7rem; min-height: 72vh; padding: 0.25rem 0 3.5rem;
		overflow-x: clip;
	}
	:global([data-theme="dark"]) .constellation-page {
		--cs-gold: #CDB27E;
		--cs-ink: #CDB27E;
		--cs-line: rgba(205, 178, 126, 0.17);
		--cs-line-hot: rgba(205, 178, 126, 0.7);
		--cs-hair: rgba(205, 178, 126, 0.3);
		--cs-shade: 0, 0, 0;
		--cs-plate-hi: #363532;
		--cs-plate-lo: #2C2B29;
		--cs-glow: rgba(205, 178, 126, 0.045);
		--cs-glint: rgba(255, 255, 255, 0.05);
	}

	.cp-head { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
	.cp-kicker {
		display: flex; align-items: center; gap: 0.9rem; margin: 0;
		font-family: var(--monospace); font-size: 0.68rem; font-weight: 600;
		letter-spacing: 0.34em; text-transform: uppercase; color: var(--cs-ink);
	}
	.cp-kicker span { margin-right: -0.34em; } /* cancel the trailing tracking so the word centres */
	.cp-kicker::before,
	.cp-kicker::after { content: ""; width: 2.4rem; height: 1px; background: var(--cs-gold); opacity: 0.5; }
	.cp-title {
		margin: 0; font-family: "KaTeX_Main", var(--serif); font-weight: 400;
		font-size: 2.65rem; line-height: 1.1; letter-spacing: 0.01em; color: var(--primary-color);
	}
	.cp-sub { margin: 0; font-size: 0.95rem; color: var(--secondary-color); }
	.cp-sub-touch { display: none; }
	@media (hover: none) {
		.cp-sub-hover { display: none; }
		.cp-sub-touch { display: inline; }
	}

	/* ===================== DIAL ===================== */
	.constellation-wrap {
		position: relative; flex: 0 0 auto;
		/* fits the viewport height on laptops, the column width on phones */
		width: min(640px, 100%, max(300px, calc(100vh - 300px)));
		width: min(640px, 100%, max(300px, calc(100svh - 300px)));
		aspect-ratio: 1 / 1;
		container-type: inline-size;
	}
	.constellation {
		--u: calc(100cqw / 640); /* one dial unit */
		position: absolute; inset: 0;
	}

	/* porcelain plate with a sunray finish radiating from the PI */
	.cs-plate {
		position: absolute; inset: calc(2 * var(--u)); border-radius: 50%;
		background:
			radial-gradient(circle at 50% 50%, var(--cs-glow) 0, transparent 26%),
			radial-gradient(circle at 50% 34%, var(--cs-plate-hi) 0%, var(--cs-plate-lo) 100%);
		box-shadow:
			inset 0 1px 0 var(--cs-glint),
			0 36px 64px -46px rgba(var(--cs-shade), 0.34),
			0 10px 26px -22px rgba(var(--cs-shade), 0.2);
		animation: cs-fade 0.9s ease backwards;
	}
	.cs-plate::before {
		content: ""; position: absolute; inset: 0; border-radius: 50%;
		background: repeating-conic-gradient(from 0deg, rgba(var(--cs-shade), 0.015) 0deg 0.3deg, transparent 0.3deg 1.2deg);
		-webkit-mask: radial-gradient(circle, transparent 15%, #000 36%, #000 86%, transparent 91%);
		mask: radial-gradient(circle, transparent 15%, #000 36%, #000 86%, transparent 91%);
	}

	.cs-dial { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }
	.cs-stop-hi { stop-color: #E6D6B4; }
	.cs-stop-mid { stop-color: #CDB386; }
	.cs-stop-lo { stop-color: #A98B58; }

	.cs-rim { fill: none; stroke: var(--cs-gold); vector-effect: non-scaling-stroke; }
	.cs-rim--outer { stroke: url(#cs-rim-grad); stroke-width: 1.1; }
	.cs-rim--inner { stroke-width: 0.6; opacity: 0.4; }

	.cs-orbit {
		fill: none; stroke: var(--cs-line); stroke-width: 1; vector-effect: non-scaling-stroke;
		transform: rotate(-90deg); transform-origin: 320px 320px; /* draw in from 12 o'clock */
		stroke-dasharray: var(--len);
		animation: cs-draw 1.8s cubic-bezier(0.65, 0, 0.35, 1) backwards;
		animation-delay: calc(0.2s + var(--ri) * 0.18s);
		transition: stroke 0.35s ease;
	}

	.cs-halo { fill: none; stroke: var(--cs-gold); stroke-width: 0.9; opacity: 0.5; vector-effect: non-scaling-stroke; }
	.cs-ticks { animation: cs-fade 1s ease 0.35s backwards; }
	.cs-tick { stroke: var(--cs-gold); stroke-width: 0.7; opacity: 0.4; vector-effect: non-scaling-stroke; }
	.cs-tick--major { stroke-width: 1.1; opacity: 0.8; }

	/* ===================== PI ===================== */
	.sun {
		position: absolute; left: 50%; top: 50%; z-index: 30; display: block;
		width: calc(128 * var(--u)); aspect-ratio: 1 / 1;
		translate: -50% -50%;
		border-radius: 50%;
		transition: opacity 0.35s ease;
	}
	.sun img {
		width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block;
		border: 3px solid var(--background-color);
		background: var(--block-color);
		box-shadow:
			0 0 0 1px var(--cs-hair),
			0 18px 32px -16px rgba(var(--cs-shade), 0.42),
			0 2px 5px rgba(var(--cs-shade), 0.12);
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
		animation: cs-pop 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s backwards;
	}

	/* ===================== ORBITS ===================== */
	/* each ring turns slowly; pointer-events:none so a full-size rotating layer never
	   swallows hovers meant for avatars underneath — the avatars re-enable them */
	.orbit {
		position: absolute; inset: 0; z-index: 20; pointer-events: none;
		/* the second animation mirrors the rotation into --spin so labels know which way is "out" */
		animation: cs-spin var(--dur) linear infinite, cs-spin-angle var(--dur) linear infinite;
	}
	.orbit--rev { animation-direction: reverse; }

	.planet {
		--s: calc(46 * var(--u));
		position: absolute; left: 50%; top: 50%;
		width: var(--s); height: var(--s);
		margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
		transform: rotate(var(--angle)) translateY(calc(var(--r) * var(--u) * -1));
		border-radius: 50%;
		pointer-events: auto;
		outline: none;
		transition: opacity 0.35s ease;
	}
	/* dial hand: in the planet's own (rotating) frame "down" always points at the PI */
	.planet::before {
		content: ""; position: absolute; left: 50%; top: 100%;
		width: 1px; margin-left: -0.5px;
		height: calc(var(--spoke) * var(--u));
		background: var(--cs-gold);
		transform: scaleY(0); transform-origin: 50% 0;
		transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
		pointer-events: none;
	}
	.planet::after {
		content: ""; position: absolute; left: 50%; top: calc(100% + var(--spoke) * var(--u));
		width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px; border-radius: 50%;
		background: var(--cs-gold);
		transform: scale(0);
		transition: transform 0.25s ease;
		pointer-events: none;
	}

	/* counter-spin keeps faces upright (static transform covers reduced motion) */
	.planet-spin {
		display: block; width: 100%; height: 100%;
		transform: rotate(calc(-1 * var(--angle)));
		animation: cs-upright var(--dur) linear infinite;
	}
	.orbit--rev .planet-spin { animation-direction: reverse; }

	.planet img {
		width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block;
		border: 2px solid var(--background-color);
		background: var(--block-color);
		box-shadow:
			0 0 0 1px var(--cs-hair),
			0 8px 14px -8px rgba(var(--cs-shade), 0.42),
			0 1px 2px rgba(var(--cs-shade), 0.12);
		transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
		animation: cs-pop 0.75s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
		animation-delay: calc(0.5s + var(--i) * 26ms);
	}

	/* ===================== LABELS ===================== */
	.cs-label {
		position: absolute; left: 50%; top: calc(100% + 10px); z-index: 6;
		display: none; flex-direction: column; align-items: center; gap: 3px;
		padding: 6px 12px 7px;
		white-space: nowrap;
		background: var(--background-color);
		border: 1px solid var(--cs-hair);
		box-shadow: 0 14px 28px -16px rgba(var(--cs-shade), 0.4), 0 1px 2px rgba(var(--cs-shade), 0.08);
		transform: translateX(-50%);
		pointer-events: none;
	}
	.cs-label--sun { top: calc(100% + 16px); }
	/* member labels open radially outward — never over the hand or the PI.
	   --t is the live direction from the centre to the face (clockwise from 12 o'clock). */
	@supports (top: calc(1px * sin(1deg))) {
		.planet .cs-label {
			--t: calc(var(--angle) + var(--spin));
			--lr: calc(var(--s) * 0.61 + 7px);
			left: calc(50% + sin(var(--t)) * var(--lr));
			top: calc(50% - cos(var(--t)) * var(--lr));
			transform: translate(calc(-50% + 50% * sin(var(--t))), calc(-50% - 50% * cos(var(--t))));
		}
	}
	.cs-label-name { font-family: "KaTeX_Main", var(--serif); font-size: 15px; line-height: 1.15; color: var(--primary-color); }
	.cs-label-role {
		font-family: var(--monospace); font-size: 9px; font-weight: 600; line-height: 1.2;
		letter-spacing: 0.16em; text-transform: uppercase; color: var(--cs-ink);
	}

	/* ===================== INTERACTION ===================== */
	/* hover/focus anywhere: the whole instrument stops */
	.constellation:has(.planet:hover, .planet:focus-visible, .sun:hover, .sun:focus-visible) :is(.orbit, .planet-spin) {
		animation-play-state: paused;
	}
	/* the chosen face lifts, its hand sweeps to the PI, its orbit lights up, the rest recede */
	.planet:hover img,
	.planet:focus-visible img {
		transform: scale(1.22);
		box-shadow:
			0 0 0 1.5px var(--cs-gold),
			0 16px 26px -12px rgba(var(--cs-shade), 0.45),
			0 2px 4px rgba(var(--cs-shade), 0.14);
	}
	.planet:hover::before,
	.planet:focus-visible::before { transform: scaleY(1); }
	.planet:is(:hover, :focus-visible)::after { transform: scale(1); transition-delay: 0.35s; }
	:is(.planet, .sun):is(:hover, :focus-visible) .cs-label { display: flex; animation: cs-label-in 0.25s cubic-bezier(0.2, 0.8, 0.2, 1); }
	.planet:is(:hover, :focus-visible) { z-index: 2; }
	.orbit:has(.planet:hover, .planet:focus-visible) { z-index: 35; } /* label above the PI and other rings */

	.constellation:has(.planet:hover, .planet:focus-visible) .planet:not(:hover, :focus-visible) { opacity: 0.26; }
	.constellation:has(.planet:hover, .planet:focus-visible) .sun { opacity: 0.72; }
	.constellation:has(.sun:hover, .sun:focus-visible) .planet { opacity: 0.5; }
	.sun:is(:hover, :focus-visible) img {
		transform: scale(1.04);
		box-shadow:
			0 0 0 1.5px var(--cs-gold),
			0 22px 38px -18px rgba(var(--cs-shade), 0.48),
			0 2px 5px rgba(var(--cs-shade), 0.14);
	}
	.sun:focus-visible { outline: none; }

	.constellation:has(.orbit-0 .planet:is(:hover, :focus-visible)) .cs-orbit-0,
	.constellation:has(.orbit-1 .planet:is(:hover, :focus-visible)) .cs-orbit-1,
	.constellation:has(.orbit-2 .planet:is(:hover, :focus-visible)) .cs-orbit-2 { stroke: var(--cs-line-hot); }


	/* ===================== MOTION ===================== */
	@property --spin { syntax: "<angle>"; inherits: true; initial-value: 0deg; }
	@keyframes cs-spin { to { transform: rotate(360deg); } }
	@keyframes cs-spin-angle { from { --spin: 0deg; } to { --spin: 360deg; } }
	@keyframes cs-label-in { from { opacity: 0; scale: 0.94; } }
	@keyframes cs-upright {
		from { transform: rotate(calc(-1 * var(--angle))); }
		to   { transform: rotate(calc(-1 * var(--angle) - 360deg)); }
	}
	@keyframes cs-pop { from { opacity: 0; scale: 0.4; } }
	@keyframes cs-fade { from { opacity: 0; } }
	@keyframes cs-draw { from { stroke-dashoffset: var(--len); } }

	@media (prefers-reduced-motion: reduce) {
		.orbit, .planet-spin, .planet img, .sun img,
		.cs-plate, .cs-orbit, .cs-ticks { animation: none !important; }
		.planet::before, .planet::after { transition: none; }
		.cs-label { animation: none !important; }
	}

	/* ===================== SMALL DIALS ===================== */
	@container (max-width: 470px) {
		.cs-tick:not(.cs-tick--major) { display: none; }
	}
	@media (max-width: 768px) {
		.constellation-page { gap: 1.4rem; }
		.cp-title { font-size: 2.1rem; }
	}
</style>
