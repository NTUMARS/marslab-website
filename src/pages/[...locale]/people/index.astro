---
import { i18n } from "astro:config/client";
import Base from "$layouts/Base.astro";
import i18nit from "$i18n";
import Icon from "$components/Icon.astro";
import { people, students, alumni } from "$data/people";

export async function getStaticPaths() {
	return i18n!.locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}

const { locale = i18n!.defaultLocale } = Astro.params;
const t = i18nit(locale);
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

// Anchor id used by the home-page photo links (/people#<id>)
const personId = (name: string) => name.toLowerCase().replace(/[^a-z]/g, '');
const initials = (name: string) => name.split(' ').map(n => n[0]).join('');

// Profile links in a fixed display order (rendered as icon-only chips)
const socialLinks = (p: any) => [
	p.links.website && { icon: "lucide:globe", label: "Website", url: p.links.website },
	p.links.email && { icon: "lucide:mail", label: "Email", url: `mailto:${p.links.email}` },
	p.links.scholar && { icon: "lucide:graduation-cap", label: "Scholar", url: p.links.scholar },
	p.links.github && { icon: "simple-icons:github", label: "GitHub", url: p.links.github },
	p.links.linkedin && { icon: "simple-icons:linkedin", label: "LinkedIn", url: p.links.linkedin },
	p.links.resume && { icon: "lucide:file-search", label: "Résumé", url: p.links.resume },
	p.links.twitter && { icon: "simple-icons:x", label: "Twitter", url: p.links.twitter },
].filter(Boolean) as { icon: string; label: string; url: string }[];

// Group members into role sections (each person lands in exactly one)
const sectionDefs = [
	{ title: "Postdocs", match: (p: any) => p.position === "Postdoc" },
	{ title: "PhD Students", match: (p: any) => p.position.startsWith("PhD") },
	{ title: "MEng Students", match: (p: any) => /MEng|Master/.test(p.position) },
	{ title: "Research Assistants", match: (p: any) => p.position === "Research Assistant" },
];

const pi = people.find(p => p.position === "Principal Investigator");
const sections = sectionDefs
	.map(s => ({ title: s.title, members: people.filter(s.match) }))
	.filter(s => s.members.length > 0);

// Safety net: surface anyone not placed in the PI slot or a section
const placed = new Set([pi, ...sections.flatMap(s => s.members)].filter(Boolean));
const others = people.filter(p => !placed.has(p));
if (others.length) sections.push({ title: "Team", members: others });

// Students: newest cohort first (year defaults to "2025"); the sort is stable,
// so the curated per-advisor order within a year is preserved.
const studentGroups = students.map(g => ({
	...g,
	members: [...g.members].sort((a, b) => Number(b.year ?? "2025") - Number(a.year ?? "2025")),
}));
---

<Base title={t("navigation.people") || "People"} {locale}>
	<main class="flex flex-col grow">
		<h1 class="text-3xl font-bold mb-8">Martian People</h1>

		{pi && (
			<section class="role-section">
				<h2 class="role-heading">Principal Investigator</h2>
				<article
					class="pi-feature"
					id={personId(pi.name)}
					data-name={pi.name}
					data-role={pi.position}
					data-img={pi.image ? `${baseUrl}${pi.image.replace(/^\//, '')}` : ''}
					data-bio={pi.bio || ''}
					data-research={pi.research || ''}
				>
					<div class="pi-photo">
						{pi.image ? (
							<img src={`${baseUrl}${pi.image.replace(/^\//, '')}`} alt={pi.name} loading="lazy" />
						) : (
							<div class="photo-placeholder"><span>{initials(pi.name)}</span></div>
						)}
					</div>
					<div class="pi-info">
						<h3 class="pi-name">{pi.name}</h3>
						<p class="pi-role">{pi.position}</p>
						{(pi.preview || pi.research) && <p class="pi-research">{pi.preview || pi.research}</p>}
						{socialLinks(pi).length > 0 && (
							<div class="person-links">
								{socialLinks(pi).map((l) => (
									<a href={l.url} class="person-link" title={l.label} aria-label={l.label} target="_blank" rel="noopener noreferrer">
										<Icon name={l.icon} size={16} />
									</a>
								))}
							</div>
						)}
					</div>
				</article>
			</section>
		)}

		{sections.map((section) => (
			<section class="role-section">
				<h2 class="role-heading">{section.title}</h2>
				<div class="people-grid">
					{section.members.map((person) => (
						<article
							class="person"
							id={personId(person.name)}
							data-name={person.name}
							data-role={person.position}
							data-img={person.image ? `${baseUrl}${person.image.replace(/^\//, '')}` : ''}
							data-bio={person.bio || ''}
							data-research={person.research || ''}
						>
							<div class="person-photo">
								{person.image ? (
									<img src={`${baseUrl}${person.image.replace(/^\//, '')}`} alt={person.name} loading="lazy" />
								) : (
									<div class="photo-placeholder"><span>{initials(person.name)}</span></div>
								)}
							</div>
							<h3 class="person-name">{person.name}</h3>
							<p class="person-role">{person.position}</p>
							{socialLinks(person).length > 0 && (
								<div class="person-links">
									{socialLinks(person).map((l) => (
										<a href={l.url} class="person-link" title={l.label} aria-label={l.label} target="_blank" rel="noopener noreferrer">
											<Icon name={l.icon} size={16} />
										</a>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			</section>
		))}

		<section class="alumni-section">
			<h2 class="alumni-heading">Students</h2>

			<div class="student-acc-wrap">
				{studentGroups.map((group) => (
					<details class="student-acc">
						<summary class="student-acc-head">
							<svg class="student-acc-tri" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M5 3l6 5-6 5z" fill="currentColor"/></svg>
							<span class="student-acc-title">{group.group}</span>
							<span class="student-acc-count">{group.members.length}</span>
						</summary>
						<ul class="alumni-list student-acc-list">
							{group.members.map((m) => (
								<li><strong>{m.name}</strong>{m.topic ? ` — ${m.topic}` : ""} <span class="alumni-period">({m.year ?? "2025"})</span></li>
							))}
						</ul>
					</details>
				))}
			</div>
		</section>

		<section class="alumni-section">
			<h2 class="alumni-heading">Alumni</h2>
			<p class="alumni-intro">We thank all MARS Lab alumni for their invaluable contributions and wish them bright futures ahead.</p>

			<details class="alumni-collapse">
				<div class="alumni-collapse-body">
					{alumni.map((cohort) => (
						<div class="alumni-group">
							<h3 class="alumni-group-title">{cohort.group}</h3>
							<ul class="alumni-list">
								{cohort.members.map((m) => (
									<li>
										<strong>{m.name}</strong>{m.note ? ` (${m.note})` : ""}{m.topic ? ` — ${m.topic}` : ""} <span class="alumni-period">({m.period})</span>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
				<summary class="alumni-toggle" aria-label="Show or hide alumni">
					<svg class="alumni-tri" viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M3 5.5l5 5 5-5z" fill="currentColor"/></svg>
				</summary>
			</details>
		</section>

		<!-- Bio modal: opened by clicking a person's photo or name -->
		<div class="bio-modal" id="bioModal" aria-hidden="true">
			<div class="bio-modal-backdrop" data-close></div>
			<div class="bio-modal-card" role="dialog" aria-modal="true" aria-label="Member biography">
				<button class="bio-modal-close" data-close aria-label="Close">✕</button>
				<div class="bio-modal-photo"><img src="" alt="" /></div>
				<div class="bio-modal-info">
					<h3 class="bio-modal-name"></h3>
					<p class="bio-modal-role"></p>
					<div class="bio-modal-bio"></div>
					<div class="bio-modal-links person-links"></div>
				</div>
			</div>
		</div>
	</main>
</Base>

<style>
	/* Role sections */
	.role-section {
		margin-bottom: 3.5rem;
	}

	.role-heading {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--primary-color);
		margin: 0 0 1.5rem 0;
		padding-bottom: 0.45rem;
		/* same gold as the global .accent-underline — a hairline, not a bar */
		border-bottom: 1px solid #C2860E;
		display: inline-block;
	}

	/* Featured PI block */
	.pi-feature {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 2rem;
		align-items: start;
		scroll-margin-top: 5rem;
	}

	.pi-photo {
		width: 200px;
		aspect-ratio: 1 / 1;
		border-radius: 0;
		overflow: hidden;
		border: 1px solid var(--shadow-color);
		background: var(--block-color);
		box-shadow: 0 6px 20px rgba(42, 42, 40, 0.10), 0 1px 2px rgba(42, 42, 40, 0.06);
		transition: border-color 0.2s ease;
	}

	.pi-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.pi-info {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}

	.pi-name {
		font-size: 1.6rem;
		font-weight: 700;
		color: var(--primary-color);
		margin: 0;
		line-height: 1.2;
	}

	.pi-role {
		font-family: var(--monospace);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0.15rem 0 0;
	}

	.pi-research {
		font-size: 0.98rem;
		line-height: 1.65;
		color: var(--primary-color);
		margin: 0.4rem 0 0.2rem 0;
		max-width: 66ch;
	}

	/* Member grid */
	.people-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 2rem 1.5rem;
	}

	.person {
		display: flex;
		flex-direction: column;
		scroll-margin-top: 5rem;
	}

	.person-photo {
		width: 100%;
		aspect-ratio: 1 / 1;
		border-radius: 0;
		overflow: hidden;
		background: var(--block-color);
		border: 1px solid var(--shadow-color);
		box-shadow: 0 6px 20px rgba(42, 42, 40, 0.10), 0 1px 2px rgba(42, 42, 40, 0.06);
		transition: border-color 0.2s ease;
	}

	.person-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.photo-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--block-color);
		font-family: var(--monospace);
		font-size: 1.6rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--remark-color);
		text-transform: uppercase;
	}

	.person-name {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--primary-color);
		margin: 0.75rem 0 0.05rem 0;
		line-height: 1.3;
	}

	.person-role {
		font-family: var(--monospace);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--secondary-color);
		margin: 0.2rem 0 0;
	}

	/* Icon-only profile links */
	.person-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 0.6rem;
	}

	.person-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		background: transparent;
		color: var(--accent);
		border: 1px solid var(--shadow-color);
		border-radius: 0;
		text-decoration: none;
		transition: border-color 0.2s ease, background-color 0.2s ease;
	}

	.person-link:hover {
		background: var(--accent-soft);
		border-color: color-mix(in srgb, var(--accent) 40%, var(--shadow-color));
	}

	.person-link :global(figure) {
		display: flex;
		align-items: center;
		margin: 0;
	}

	.person-link :global(svg) {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	/* Photo & name are clickable to open the bio modal */
	.person-photo,
	.person-name,
	.pi-photo,
	.pi-name {
		cursor: pointer;
	}

	.person-photo:hover,
	.pi-photo:hover {
		border-color: color-mix(in srgb, var(--accent) 40%, var(--shadow-color));
	}

	.person-name:hover,
	.pi-name:hover {
		color: var(--accent-deep);
	}

	/* Bio modal */
	.bio-modal {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
	}

	.bio-modal.open {
		display: flex;
	}

	.bio-modal-backdrop {
		position: absolute;
		inset: 0;
		/* warm, faintly amber-cast veil */
		background: rgba(30, 24, 12, 0.42);
		backdrop-filter: blur(10px) saturate(0.9);
		-webkit-backdrop-filter: blur(10px) saturate(0.9);
		animation: bm-fade 0.2s ease;
	}

	/* Editorial print spread: photo bleeds to the card's left edge, the text
	   column reads like a book page. Height follows the content (short bios
	   get a compact card); long bios scroll inside the bio block. */
	.bio-modal-card {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 300px 1fr;
		gap: 0;
		width: min(760px, 100%);
		/* height follows the text column; the cap lives on .bio-modal-info —
		   a max-height on the grid container would NOT constrain the row, the
		   grid would lay out at content height and just get clipped. */
		height: auto;
		min-height: 400px;
		background: var(--background-color);
		border: 1px solid var(--shadow-color);
		border-radius: 0;
		box-shadow: 0 32px 80px rgba(0, 0, 0, 0.35), 0 4px 16px rgba(0, 0, 0, 0.18);
		padding: 0;
		overflow: hidden;
		animation: bm-pop 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	@keyframes bm-fade {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes bm-pop {
		from { opacity: 0; transform: translateY(10px) scale(0.96); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}

	@media (prefers-reduced-motion: reduce) {
		.bio-modal-backdrop,
		.bio-modal-card {
			animation: none;
		}
	}

	/* Photo column — full-bleed against the card's left/top/bottom edges */
	.bio-modal-photo {
		position: relative;
		min-height: 100%;
		background: var(--block-color);
		border-right: 1px solid var(--shadow-color);
	}

	.bio-modal-photo img {
		/* absolute so the column height tracks the text column, not the image */
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: none;
		border-radius: 0;
		display: block;
	}

	/* Content column — the "page": kicker, name, gold rule, bio, links.
	   The max-height here is what makes long bios scroll internally. */
	.bio-modal-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
		max-height: min(560px, 85vh);
		padding: 2rem 2.25rem 1.4rem 2rem;
	}

	.bio-modal-role {
		/* kicker above the name — pure CSS reorder, DOM/a11y order unchanged */
		order: -1;
		font-family: var(--monospace);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 0.6rem;
		flex-shrink: 0;
	}

	.bio-modal-name {
		font-family: "KaTeX_Main", var(--serif);
		font-size: 1.8rem;
		font-weight: 700;
		line-height: 1.15;
		color: var(--primary-color);
		margin: 0;
		flex-shrink: 0;
	}

	/* short gold rule under the name — echoes the .accent-underline gold */
	.bio-modal-name::after {
		content: "";
		display: block;
		width: 44px;
		height: 2px;
		background: #C2860E;
		margin-top: 0.85rem;
	}

	.bio-modal-bio {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		margin-top: 1.1rem;
		padding-right: 0.75rem;
		/* hairline scrollbar — the default bar reads as a heavy rule on the "page" */
		scrollbar-width: thin;
		scrollbar-color: var(--shadow-color) transparent;
	}

	.bio-modal-bio::-webkit-scrollbar {
		width: 4px;
	}

	.bio-modal-bio::-webkit-scrollbar-track {
		background: transparent;
	}

	.bio-modal-bio::-webkit-scrollbar-thumb {
		background: var(--shadow-color);
	}

	.bio-modal-bio :global(p) {
		font-size: 0.93rem;
		line-height: 1.7;
		color: var(--primary-color);
		margin: 0 0 0.8rem 0;
	}

	.bio-modal-bio :global(p:last-child) {
		margin-bottom: 0;
	}

	.bio-modal-links {
		flex-shrink: 0;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--shadow-color);
	}

	/* Ghost close button */
	.bio-modal-close {
		position: absolute;
		top: 0.65rem;
		right: 0.65rem;
		width: 34px;
		height: 34px;
		border: none;
		background: transparent;
		color: var(--secondary-color);
		border-radius: 0;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.05rem;
		line-height: 1;
		z-index: 2;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.bio-modal-close:hover {
		background: var(--accent-soft);
		color: var(--accent-deep);
	}

	:global(body.modal-open) {
		overflow: hidden;
	}

	/* Future-proofing: if a member ever has no photo the JS hides the photo
	   column — collapse the grid so the text doesn't sit in the 300px track. */
	.bio-modal-card:has(.bio-modal-photo[style*="none"]) {
		grid-template-columns: 1fr;
	}

	@media (max-width: 640px) {
		.bio-modal {
			padding: 1rem;
		}

		.bio-modal-card {
			grid-template-columns: 1fr;
			min-height: 0;
			max-height: 88vh;
			overflow-y: auto;
		}

		/* full-bleed banner crop up top */
		.bio-modal-photo {
			min-height: 0;
			height: 230px;
			border-right: none;
			border-bottom: 1px solid var(--shadow-color);
		}

		.bio-modal-info {
			max-height: none; /* the whole card scrolls on mobile */
			padding: 1.3rem 1.25rem 1.1rem;
		}

		.bio-modal-name {
			font-size: 1.45rem;
		}

		/* On mobile the whole card scrolls, so the bio doesn't need its own scroll */
		.bio-modal-bio {
			overflow: visible;
			padding-right: 0;
		}

		/* ✕ sits over the photo — give it a translucent plate */
		.bio-modal-close {
			background: color-mix(in srgb, var(--background-color) 82%, transparent);
		}
	}

	/* Alumni — plain text list */
	.alumni-section {
		margin-top: 1rem;
	}

	.alumni-heading {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--primary-color);
		margin: 0 0 0.75rem 0;
		padding-bottom: 0.45rem;
		border-bottom: 1px solid #C2860E;
		display: inline-block;
	}

	.alumni-intro {
		color: var(--secondary-color);
		margin: 0 0 1.5rem 0;
	}

	.alumni-group {
		margin-bottom: 1.75rem;
	}

	.alumni-group-title {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--primary-color);
		margin: 0 0 0.6rem 0;
	}

	.alumni-list {
		list-style: disc;
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.alumni-list li {
		color: var(--secondary-color);
		line-height: 1.6;
	}

	.alumni-list strong {
		color: var(--primary-color);
	}

	.alumni-period {
		color: var(--remark-color);
		white-space: nowrap;
	}

	/* Current students — each degree level is its own collapsible toggle:
	   a brand-accent ▶ triangle + the group name; click reveals the name list.
	   Editorial hairline dividers keep it elegant and on-brand. */
	.student-acc-wrap {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--shadow-color);
		margin-top: 0.25rem;
	}

	.student-acc {
		border-bottom: 1px solid var(--shadow-color);
	}

	.student-acc-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.9rem 0.35rem;
		cursor: pointer;
		list-style: none;
		user-select: none;
		transition: background-color 0.18s ease;
	}

	.student-acc-head::-webkit-details-marker {
		display: none;
	}

	.student-acc-head:hover {
		background-color: var(--accent-soft);
	}

	.student-acc-tri {
		color: var(--accent);
		flex-shrink: 0;
		transition: transform 0.22s cubic-bezier(0.22, 0.68, 0.28, 1), color 0.18s ease;
	}

